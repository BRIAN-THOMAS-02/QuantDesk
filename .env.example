# Zerodha Kite Connect credentials (get from https://developers.kite.trade)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Request token generated after daily login flow (see README - Kite section)
KITE_REQUEST_TOKEN=
KITE_ACCESS_TOKEN=

# Trading mode: paper (default, safe) | live (requires explicit flag + keys)
TRADING_MODE=paper

# Capital settings
CAPITAL=500000
RISK_PER_TRADE_PCT=1.0
MAX_POSITIONS=10
